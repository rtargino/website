@unpublished{riva2026rbmv,
 abstract = {Mean-variance portfolios exploit expected returns but concentrate risk, while risk budgeting controls how risk is shared but ignores expected returns. We propose the Risk-Budgeted Mean-Variance (RBMV) portfolio, which adds a minimum expected return and a maximum volatility to the risk budgeting problem. The resulting program is convex, has a unique solution when feasible, and nests risk budgeting. The portfolio's distance to the risk budget traces a cost curve showing how much risk budgeting is given up for each extra unit of expected return. Out of sample, in U.S. stocks, industry portfolios, and multi-asset ETFs, RBMV earns higher average returns than risk parity, with much lower turnover and concentration than mean-variance portfolios.},
 author = {Riva, Raul and Targino, Rodrigo S and da Costa, Bernardo Freitas Paulo},
 title = {Risk-Budgeted Mean-Variance Portfolios},
 url = {https://dx.doi.org/10.2139/ssrn.7672259},
 year = {2026}
}
